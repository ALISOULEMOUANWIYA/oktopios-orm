// =====================================================================
//  oktopios-framework — Couche ORM
//  Écrit EN Oktopios, s'appuie sur la réflexion et les décorateurs du
//  langage (>= 0.6.0). Chargé via :  use "framework/orm.okp"
//
//  - Schema : migrations (génère le schéma SQL depuis les modèles décorés)
//  - Repo   : dépôt générique (save / all / findBy / remove + hydratation)
//  - Query  : constructeur de requêtes fluide
//
//  Décorateurs reconnus :
//    @Entity("table")   (classe)  -> nom de table
//    @Column("colonne") (champ)   -> nom de colonne
//    @Id                (champ)   -> clé primaire
// =====================================================================
inject Type
inject DataImport

// ---------------------------------------------------------------------
//  Schema — génération de schéma / migrations
// ---------------------------------------------------------------------
class Schema {
    fun sqlType(t: string): string {
        if (t == "int")   { return "INTEGER" }
        if (t == "float") { return "REAL" }
        if (t == "bool")  { return "INTEGER" }
        return "TEXT"
    }

    fun tableName(entity: any): string {
        var e = Type.annotation(entity, "Entity")
        if (e != null) { return e[0] }
        return Type.className(entity)
    }

    fun columnName(entity: any, champ: string): string {
        var c = Type.fieldAnnotation(entity, champ, "Column")
        if (c != null) { return c[0] }
        return champ
    }

    fun idField(entity: any): string {
        for (f in Type.fields(entity)) {
            if (Type.fieldAnnotation(entity, f, "Id") != null) { return f }
        }
        return "id"
    }

    // --- Relations @ManyToOne("ClasseLiee", "colonne_fk"?) --------------
    fun isRelation(entity: any, f: string): bool {
        return Type.fieldAnnotation(entity, f, "ManyToOne") != null
    }

    fun relClass(entity: any, f: string): string {
        var a = Type.fieldAnnotation(entity, f, "ManyToOne")
        return a[0]
    }

    // Colonne de clé étrangère : 2e argument du décorateur, sinon <champ>_id.
    fun fkColumn(entity: any, f: string): string {
        var a = Type.fieldAnnotation(entity, f, "ManyToOne")
        var n = 0
        for (x in a) { n = n + 1 }
        if (n > 1) { return a[1] }
        return f + "_id"
    }

    fun createTableSQL(entity: any): string {
        var defs = ""
        for (f in Type.fields(entity)) {
            if (defs != "") { defs = defs + ", " }
            if (this.isRelation(entity, f) == true) {
                // Relation -> colonne de clé étrangère entière.
                defs = defs + this.fkColumn(entity, f) + " INTEGER"
            } else {
                var ligne = this.columnName(entity, f) + " " + this.sqlType(Type.fieldType(entity, f))
                if (Type.fieldAnnotation(entity, f, "Id") != null) {
                    ligne = ligne + " PRIMARY KEY"
                }
                defs = defs + ligne
            }
        }
        return "CREATE TABLE IF NOT EXISTS " + this.tableName(entity) + " (" + defs + ")"
    }

    // Crée la table dans la base à partir d'un exemple d'entité (modèle décoré)
    fun migrate(db: string, entity: any): string {
        var sql = this.createTableSQL(entity)
        DataImport.execSQL(db, sql, [])
        return sql
    }
}

// ---------------------------------------------------------------------
//  Repo — dépôt de données générique pour un modèle
// ---------------------------------------------------------------------
class Repo {
    var db: string
    var table: string
    var model: string
    var schema: Schema

    // `sample` : une instance du modèle, utilisée pour lire les métadonnées
    fun __construct(db: string, sample: any) {
        this.db = db
        this.schema = new Schema()
        this.table = this.schema.tableName(sample)
        this.model = Type.className(sample)
    }

    // Insère l'entité. La clé primaire (@Id) est omise pour laisser la base
    // l'auto-générer ; `save` renvoie l'identifiant de la ligne créée.
    // Pour une relation @ManyToOne, on écrit la clé étrangère (id de l'objet lié).
    fun save(entity: any): int {
        var idf = this.schema.idField(entity)
        var colonnes = ""
        var marques = ""
        var valeurs = []
        for (f in Type.fields(entity)) {
            if (f != idf) {
                if (colonnes != "") {
                    colonnes = colonnes + ", "
                    marques = marques + ", "
                }
                if (this.schema.isRelation(entity, f) == true) {
                    colonnes = colonnes + this.schema.fkColumn(entity, f)
                    marques = marques + "?"
                    var lie = Type.get(entity, f)
                    if (lie == null) {
                        valeurs = valeurs + [null]
                    } else {
                        valeurs = valeurs + [Type.get(lie, this.schema.idField(lie))]
                    }
                } else {
                    colonnes = colonnes + this.schema.columnName(entity, f)
                    marques = marques + "?"
                    valeurs = valeurs + [Type.get(entity, f)]
                }
            }
        }
        var sql = "INSERT INTO " + this.table + " (" + colonnes + ") VALUES (" + marques + ")"
        var nouvelId = DataImport.execSQL(this.db, sql, valeurs)
        // Réaffecte la clé primaire générée sur l'entité (comme Django/Doctrine),
        // pour que les relations ultérieures écrivent le bon id.
        Type.set(entity, idf, nouvelId)
        return nouvelId
    }

    // Transforme les lignes SQL (colonnes) en instances du modèle (champs).
    // `avecRelations` : si vrai, charge aussi les objets liés (@ManyToOne),
    // un seul niveau de profondeur (pas de récursion sur leurs relations).
    fun hydrateOne(ligne: any, avecRelations: bool): any {
        var obj = Type.create(this.model)
        for (f in Type.fields(obj)) {
            if (this.schema.isRelation(obj, f) == true) {
                if (avecRelations == true) {
                    var fk = ligne[this.schema.fkColumn(obj, f)]
                    if (fk != null) {
                        var relRepo = new Repo(this.db, Type.create(this.schema.relClass(obj, f)))
                        var lies = relRepo.findByRaw(relRepo.idColumn(), fk, false)
                        var m = 0
                        for (z in lies) { m = m + 1 }
                        if (m > 0) { Type.set(obj, f, lies[0]) }
                    }
                }
            } else {
                var col = this.schema.columnName(obj, f)
                Type.set(obj, f, ligne[col])
            }
        }
        return obj
    }

    fun hydrate(lignes: any): any {
        var objets = []
        for (ligne in lignes) {
            objets = objets + [this.hydrateOne(ligne, true)]
        }
        return objets
    }

    fun idColumn(): string {
        var ex = Type.create(this.model)
        return this.schema.columnName(ex, this.schema.idField(ex))
    }

    // Hydrate une liste de lignes, en chargeant (ou non) les relations.
    fun hydrateAll(lignes: any, avecRelations: bool): any {
        var objets = []
        for (ligne in lignes) {
            objets = objets + [this.hydrateOne(ligne, avecRelations)]
        }
        return objets
    }

    fun all(): any {
        return this.hydrate(DataImport.execSQL(this.db, "SELECT * FROM " + this.table, []))
    }

    fun findBy(colonne: string, valeur: any): any {
        return this.findByRaw(colonne, valeur, true)
    }

    // Variante de findBy avec contrôle du chargement des relations
    // (utilisée en interne pour éviter la récursion lors de l'hydratation).
    fun findByRaw(colonne: string, valeur: any, avecRelations: bool): any {
        var sql = "SELECT * FROM " + this.table + " WHERE " + colonne + " = ?"
        return this.hydrateAll(DataImport.execSQL(this.db, sql, [valeur]), avecRelations)
    }

    // Récupère une entité par son id (relations chargées), ou null.
    fun find(id: any): any {
        var lies = this.findByRaw(this.idColumn(), id, true)
        var n = 0
        for (x in lies) { n = n + 1 }
        if (n == 0) { return null }
        return lies[0]
    }

    fun remove(colonne: string, valeur: any): int {
        var sql = "DELETE FROM " + this.table + " WHERE " + colonne + " = ?"
        return DataImport.execSQL(this.db, sql, [valeur])
    }

    // Nombre total de lignes de la table.
    fun count(): int {
        var lignes = DataImport.execSQL(this.db, "SELECT COUNT(*) AS n FROM " + this.table, [])
        return lignes[0]["n"]
    }

    // Une page d'entités (relations chargées). `perPage` et `page` sont des
    // entiers (page >= 1).
    fun page(perPage: int, page: int): any {
        var dec = (page - 1) * perPage
        var sql = "SELECT * FROM " + this.table + " LIMIT " + perPage + " OFFSET " + dec
        return this.hydrate(DataImport.execSQL(this.db, sql, []))
    }
}

// ---------------------------------------------------------------------
//  Query — constructeur de requêtes fluide
// ---------------------------------------------------------------------
class Query {
    var db: string
    var table: string
    var champs: string
    var conds: string
    var params: any
    var ordre: string
    var borne: string

    fun __construct(db: string, table: string) {
        this.db = db
        this.table = table
        this.champs = "*"
        this.conds = ""
        this.params = []
        this.ordre = ""
        this.borne = ""
    }

    // Pagination : LIMIT n [OFFSET d]
    fun limit(n: any): Query {
        this.borne = " LIMIT " + n
        return this
    }
    fun offset(d: any): Query {
        this.borne = this.borne + " OFFSET " + d
        return this
    }

    fun select(champs: string): Query {
        this.champs = champs
        return this
    }

    fun where(colonne: string, op: string, valeur: any): Query {
        if (this.conds != "") { this.conds = this.conds + " AND " }
        this.conds = this.conds + colonne + " " + op + " ?"
        this.params = this.params + [valeur]
        return this
    }

    fun orderBy(colonne: string, sens: string): Query {
        this.ordre = " ORDER BY " + colonne + " " + sens
        return this
    }

    fun sql(): string {
        var s = "SELECT " + this.champs + " FROM " + this.table
        if (this.conds != "") { s = s + " WHERE " + this.conds }
        s = s + this.ordre
        s = s + this.borne
        return s
    }

    fun get(): any {
        return DataImport.execSQL(this.db, this.sql(), this.params)
    }

    // Nombre total de lignes correspondant aux conditions (sans borne) —
    // utile pour calculer le nombre de pages.
    fun count(): int {
        var s = "SELECT COUNT(*) AS n FROM " + this.table
        if (this.conds != "") { s = s + " WHERE " + this.conds }
        var lignes = DataImport.execSQL(this.db, s, this.params)
        return lignes[0]["n"]
    }
}
