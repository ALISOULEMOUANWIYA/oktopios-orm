// =====================================================================
//  oktopios-framework — Couche ORM
//  Écrit EN Oktopios, s'appuie sur la réflexion et les décorateurs du
//  langage (>= 0.6.0). Chargé via :  use "framework/orm.okp"
//
//  - Schema : migrations (génère le schéma SQL depuis les modèles décorés)
//  - Repo   : dépôt générique (save / all / findBy / remove + hydratation)
//  - Query  : constructeur de requêtes fluide
//
//  Décorateurs reconnus :
//    @Entity("table")   (classe)  -> nom de table
//    @Column("colonne") (champ)   -> nom de colonne
//    @Id                (champ)   -> clé primaire
// =====================================================================
inject Type
inject DataImport
inject String
inject Map

// ---------------------------------------------------------------------
//  Schema — génération de schéma / migrations
// ---------------------------------------------------------------------
class Schema {
    fun sqlType(t: string): string {
        if (t == "int")   { return "INTEGER" }
        if (t == "float") { return "REAL" }
        if (t == "bool")  { return "INTEGER" }
        return "TEXT"
    }

    fun tableName(entity: any): string {
        var e = Type.annotation(entity, "Entity")
        if (e != null) { return e[0] }
        return Type.className(entity)
    }

    fun columnName(entity: any, champ: string): string {
        var c = Type.fieldAnnotation(entity, champ, "Column")
        if (c != null) { return c[0] }
        return champ
    }

    fun idField(entity: any): string {
        for (f in Type.fields(entity)) {
            if (Type.fieldAnnotation(entity, f, "Id") != null) { return f }
        }
        return "id"
    }

    // --- Relations ------------------------------------------------------
    //  @ManyToOne("Classe", "fk"?)                        -> colonne FK ici
    //  @OneToMany("ClasseEnfant", "fk_dans_enfant")       -> collection (inverse)
    //  @ManyToMany("Autre", "table_jointure", "fk_ici", "fk_autre") -> N-N

    fun isRelation(entity: any, f: string): bool {
        return Type.fieldAnnotation(entity, f, "ManyToOne") != null
    }
    fun isOneToMany(entity: any, f: string): bool {
        return Type.fieldAnnotation(entity, f, "OneToMany") != null
    }
    fun isManyToMany(entity: any, f: string): bool {
        return Type.fieldAnnotation(entity, f, "ManyToMany") != null
    }
    // Vrai pour une relation « collection » (pas de colonne sur cette table).
    fun isCollection(entity: any, f: string): bool {
        if (this.isOneToMany(entity, f) == true) { return true }
        return this.isManyToMany(entity, f)
    }

    fun relClass(entity: any, f: string): string {
        var a = Type.fieldAnnotation(entity, f, "ManyToOne")
        return a[0]
    }

    // Colonne de clé étrangère @ManyToOne : 2e argument, sinon <champ>_id.
    fun fkColumn(entity: any, f: string): string {
        var a = Type.fieldAnnotation(entity, f, "ManyToOne")
        var n = 0
        for (x in a) { n = n + 1 }
        if (n > 1) { return a[1] }
        return f + "_id"
    }

    // @OneToMany("ClasseEnfant", "fk_dans_enfant")
    fun o2mClass(entity: any, f: string): string {
        var a = Type.fieldAnnotation(entity, f, "OneToMany")
        return a[0]
    }
    // Colonne FK dans l'enfant : 2e argument, sinon inférée <classe>_id
    // (inverse automatique d'un @ManyToOne). Ex. Auteur -> "auteur_id".
    fun o2mFk(entity: any, f: string): string {
        var a = Type.fieldAnnotation(entity, f, "OneToMany")
        var n = 0
        for (x in a) { n = n + 1 }
        if (n > 1) { return a[1] }
        return String.lower(Type.className(entity)) + "_id"
    }

    // @ManyToMany("Autre", "table_jointure", "fk_ici", "fk_autre")
    fun m2mClass(entity: any, f: string): string {
        var a = Type.fieldAnnotation(entity, f, "ManyToMany")
        return a[0]
    }
    fun m2mJoin(entity: any, f: string): string {
        var a = Type.fieldAnnotation(entity, f, "ManyToMany")
        return a[1]
    }
    fun m2mFkHere(entity: any, f: string): string {
        var a = Type.fieldAnnotation(entity, f, "ManyToMany")
        return a[2]
    }
    fun m2mFkOther(entity: any, f: string): string {
        var a = Type.fieldAnnotation(entity, f, "ManyToMany")
        return a[3]
    }

    fun createTableSQL(entity: any): string {
        var defs = ""
        for (f in Type.fields(entity)) {
            if (this.isCollection(entity, f) == false) {
                // (les collections @OneToMany/@ManyToMany n'ont pas de colonne ici)
                var morceau = ""
                if (this.isRelation(entity, f) == true) {
                    morceau = this.fkColumn(entity, f) + " INTEGER"
                } else {
                    morceau = this.columnName(entity, f) + " " + this.sqlType(Type.fieldType(entity, f))
                    if (Type.fieldAnnotation(entity, f, "Id") != null) {
                        morceau = morceau + " PRIMARY KEY"
                    }
                }
                if (defs != "") { defs = defs + ", " }
                defs = defs + morceau
            }
        }
        return "CREATE TABLE IF NOT EXISTS " + this.tableName(entity) + " (" + defs + ")"
    }

    // Crée la table de l'entité + les tables de jointure de ses @ManyToMany.
    fun migrate(db: string, entity: any): string {
        var sql = this.createTableSQL(entity)
        DataImport.execSQL(db, sql, [])
        for (f in Type.fields(entity)) {
            if (this.isManyToMany(entity, f) == true) {
                var jt = this.m2mJoin(entity, f)
                var jsql = "CREATE TABLE IF NOT EXISTS " + jt + " (" + this.m2mFkHere(entity, f) + " INTEGER, " + this.m2mFkOther(entity, f) + " INTEGER)"
                DataImport.execSQL(db, jsql, [])
            }
        }
        return sql
    }
}

// ---------------------------------------------------------------------
//  Repo — dépôt de données générique pour un modèle
// ---------------------------------------------------------------------
class Repo {
    var db: string
    var table: string
    var model: string
    var schema: Schema

    // `sample` : une instance du modèle, utilisée pour lire les métadonnées
    fun __construct(db: string, sample: any) {
        this.db = db
        this.schema = new Schema()
        this.table = this.schema.tableName(sample)
        this.model = Type.className(sample)
    }

    // Insère l'entité. La clé primaire (@Id) est omise pour laisser la base
    // l'auto-générer ; `save` renvoie l'identifiant de la ligne créée.
    // Pour une relation @ManyToOne, on écrit la clé étrangère (id de l'objet lié).
    fun save(entity: any): int {
        var idf = this.schema.idField(entity)
        var colonnes = ""
        var marques = ""
        var valeurs = []
        for (f in Type.fields(entity)) {
            // On saute la clé primaire (auto) et les collections (pas de colonne).
            if (f != idf) {
                if (this.schema.isCollection(entity, f) == false) {
                    var col = ""
                    var valeur = null
                    if (this.schema.isRelation(entity, f) == true) {
                        col = this.schema.fkColumn(entity, f)
                        var lie = Type.get(entity, f)
                        if (lie != null) {
                            valeur = Type.get(lie, this.schema.idField(lie))
                        }
                    } else {
                        col = this.schema.columnName(entity, f)
                        valeur = Type.get(entity, f)
                    }
                    if (colonnes != "") {
                        colonnes = colonnes + ", "
                        marques = marques + ", "
                    }
                    colonnes = colonnes + col
                    marques = marques + "?"
                    valeurs = valeurs + [valeur]
                }
            }
        }
        var sql = "INSERT INTO " + this.table + " (" + colonnes + ") VALUES (" + marques + ")"
        var nouvelId = DataImport.execSQL(this.db, sql, valeurs)
        // Réaffecte la clé primaire générée sur l'entité (comme Django/Doctrine),
        // pour que les relations ultérieures écrivent le bon id.
        Type.set(entity, idf, nouvelId)
        return nouvelId
    }

    // Lie `entity` à `lie` via la table de jointure du champ @ManyToMany `f`.
    fun attach(entity: any, f: string, lie: any): int {
        var jt = this.schema.m2mJoin(entity, f)
        var monId = Type.get(entity, this.schema.idField(entity))
        var autreId = Type.get(lie, this.schema.idField(lie))
        var sql = "INSERT INTO " + jt + " (" + this.schema.m2mFkHere(entity, f) + ", " + this.schema.m2mFkOther(entity, f) + ") VALUES (?, ?)"
        return DataImport.execSQL(this.db, sql, [monId, autreId])
    }

    // Transforme les lignes SQL (colonnes) en instances du modèle (champs).
    // `avecRelations` : si vrai, charge aussi les objets liés (@ManyToOne),
    // un seul niveau de profondeur (pas de récursion sur leurs relations).
    fun hydrateOne(ligne: any, avecRelations: bool): any {
        var obj = Type.create(this.model)
        for (f in Type.fields(obj)) {
            if (this.schema.isRelation(obj, f) == true) {
                if (avecRelations == true) { this.chargeM2O(obj, f, ligne) }
            } else {
                if (this.schema.isOneToMany(obj, f) == true) {
                    if (avecRelations == true) { this.chargeO2M(obj, f, ligne) }
                } else {
                    if (this.schema.isManyToMany(obj, f) == true) {
                        if (avecRelations == true) { this.chargeM2M(obj, f, ligne) }
                    } else {
                        var col = this.schema.columnName(obj, f)
                        Type.set(obj, f, ligne[col])
                    }
                }
            }
        }
        return obj
    }

    // @ManyToOne : charge l'objet lié (un seul).
    fun chargeM2O(obj: any, f: string, ligne: any): any {
        var fk = ligne[this.schema.fkColumn(obj, f)]
        if (fk == null) { return null }
        var relRepo = new Repo(this.db, Type.create(this.schema.relClass(obj, f)))
        var lies = relRepo.findByRaw(relRepo.idColumn(), fk, false)
        var m = 0
        for (z in lies) { m = m + 1 }
        if (m > 0) { Type.set(obj, f, lies[0]) }
        return null
    }

    // @OneToMany : collection d'enfants (enfant.fk = mon id).
    fun chargeO2M(obj: any, f: string, ligne: any): any {
        var monId = ligne[this.idColumn()]
        var enfRepo = new Repo(this.db, Type.create(this.schema.o2mClass(obj, f)))
        var enfants = enfRepo.findByRaw(this.schema.o2mFk(obj, f), monId, false)
        Type.set(obj, f, enfants)
        return null
    }

    // @ManyToMany : collection via table de jointure.
    fun chargeM2M(obj: any, f: string, ligne: any): any {
        var monId = ligne[this.idColumn()]
        var autreRepo = new Repo(this.db, Type.create(this.schema.m2mClass(obj, f)))
        var jointure = this.schema.m2mJoin(obj, f)
        var fkAutre = this.schema.m2mFkOther(obj, f)
        var fkIci = this.schema.m2mFkHere(obj, f)
        var jsql = "SELECT o.* FROM " + autreRepo.table + " o JOIN " + jointure + " j ON o." + autreRepo.idColumn() + " = j." + fkAutre + " WHERE j." + fkIci + " = ?"
        var lignes = DataImport.execSQL(this.db, jsql, [monId])
        var relus = []
        for (r in lignes) {
            var o = autreRepo.hydrateOne(r, false)
            relus = relus + [o]
        }
        Type.set(obj, f, relus)
        return null
    }

    fun hydrate(lignes: any): any {
        var objets = []
        for (ligne in lignes) {
            objets = objets + [this.hydrateOne(ligne, true)]
        }
        return objets
    }

    fun idColumn(): string {
        var ex = Type.create(this.model)
        return this.schema.columnName(ex, this.schema.idField(ex))
    }

    // Hydrate une liste de lignes, en chargeant (ou non) les relations.
    fun hydrateAll(lignes: any, avecRelations: bool): any {
        var objets = []
        for (ligne in lignes) {
            objets = objets + [this.hydrateOne(ligne, avecRelations)]
        }
        return objets
    }

    fun all(): any {
        return this.hydrate(DataImport.execSQL(this.db, "SELECT * FROM " + this.table, []))
    }

    fun findBy(colonne: string, valeur: any): any {
        return this.findByRaw(colonne, valeur, true)
    }

    // Variante de findBy avec contrôle du chargement des relations
    // (utilisée en interne pour éviter la récursion lors de l'hydratation).
    fun findByRaw(colonne: string, valeur: any, avecRelations: bool): any {
        var sql = "SELECT * FROM " + this.table + " WHERE " + colonne + " = ?"
        return this.hydrateAll(DataImport.execSQL(this.db, sql, [valeur]), avecRelations)
    }

    // Récupère une entité par son id (relations chargées), ou null.
    fun find(id: any): any {
        var lies = this.findByRaw(this.idColumn(), id, true)
        var n = 0
        for (x in lies) { n = n + 1 }
        if (n == 0) { return null }
        return lies[0]
    }

    // Comme find mais SANS charger les relations (chargement paresseux).
    fun findLazy(id: any): any {
        var lies = this.findByRaw(this.idColumn(), id, false)
        var n = 0
        for (x in lies) { n = n + 1 }
        if (n == 0) { return null }
        return lies[0]
    }

    // Enregistre l'entité puis, en cascade, ses collections @OneToMany :
    // chaque enfant reçoit une référence au parent et est sauvegardé.
    fun saveCascade(entity: any): int {
        var id = this.save(entity)
        for (f in Type.fields(entity)) {
            if (this.schema.isOneToMany(entity, f) == true) {
                var enfants = Type.get(entity, f)
                if (enfants != null) {
                    var enfRepo = new Repo(this.db, Type.create(this.schema.o2mClass(entity, f)))
                    var fkCol = this.schema.o2mFk(entity, f)
                    for (enf in enfants) {
                        for (cf in Type.fields(enf)) {
                            if (this.schema.isRelation(enf, cf) == true) {
                                if (this.schema.fkColumn(enf, cf) == fkCol) {
                                    Type.set(enf, cf, entity)
                                }
                            }
                        }
                        enfRepo.save(enf)
                    }
                }
            }
        }
        return id
    }

    fun remove(colonne: string, valeur: any): int {
        var sql = "DELETE FROM " + this.table + " WHERE " + colonne + " = ?"
        return DataImport.execSQL(this.db, sql, [valeur])
    }

    // Nombre total de lignes de la table.
    fun count(): int {
        var lignes = DataImport.execSQL(this.db, "SELECT COUNT(*) AS n FROM " + this.table, [])
        return lignes[0]["n"]
    }

    // Une page d'entités (relations chargées). `perPage` et `page` sont des
    // entiers (page >= 1).
    fun page(perPage: int, page: int): any {
        var dec = (page - 1) * perPage
        var sql = "SELECT * FROM " + this.table + " LIMIT " + perPage + " OFFSET " + dec
        return this.hydrate(DataImport.execSQL(this.db, sql, []))
    }

    // Constructeur de requête lié à la table de ce dépôt.
    //   repo.hydrateRows(repo.query().where("age", ">", 18).orderBy("nom","ASC").get())
    fun query(): Query {
        return new Query(this.db, this.table)
    }

    // Hydrate des lignes SQL (ex. résultat d'un Query) en entités du modèle.
    fun hydrateRows(lignes: any): any {
        return this.hydrateAll(lignes, true)
    }
}

// ---------------------------------------------------------------------
//  Query — constructeur de requêtes fluide
// ---------------------------------------------------------------------
class Query {
    var db: string
    var table: string
    var champs: string
    var conds: string
    var params: any
    var ordre: string
    var borne: string
    var jointures: string

    fun __construct(db: string, table: string) {
        this.db = db
        this.table = table
        this.champs = "*"
        this.conds = ""
        this.params = []
        this.ordre = ""
        this.borne = ""
        this.jointures = ""
    }

    // Pagination : LIMIT n [OFFSET d]
    fun limit(n: any): Query {
        this.borne = " LIMIT " + n
        return this
    }
    fun offset(d: any): Query {
        this.borne = this.borne + " OFFSET " + d
        return this
    }

    fun select(champs: string): Query {
        this.champs = champs
        return this
    }

    // Condition AND : colonne op ?  (ex. where("age", ">", 18))
    fun where(colonne: string, op: string, valeur: any): Query {
        if (this.conds != "") { this.conds = this.conds + " AND " }
        this.conds = this.conds + colonne + " " + op + " ?"
        this.params = this.params + [valeur]
        return this
    }

    // Condition OR.
    fun orWhere(colonne: string, op: string, valeur: any): Query {
        if (this.conds != "") { this.conds = this.conds + " OR " }
        this.conds = this.conds + colonne + " " + op + " ?"
        this.params = this.params + [valeur]
        return this
    }

    // colonne IN (?, ?, …)
    fun whereIn(colonne: string, valeurs: any): Query {
        var marques = ""
        for (v in valeurs) {
            if (marques != "") { marques = marques + ", " }
            marques = marques + "?"
            this.params = this.params + [v]
        }
        if (this.conds != "") { this.conds = this.conds + " AND " }
        this.conds = this.conds + colonne + " IN (" + marques + ")"
        return this
    }

    // colonne LIKE ?   (ex. like("titre", "%okp%"))
    fun like(colonne: string, motif: any): Query {
        if (this.conds != "") { this.conds = this.conds + " AND " }
        this.conds = this.conds + colonne + " LIKE ?"
        this.params = this.params + [motif]
        return this
    }

    // JOIN brut : join("auteurs a", "a.id = articles.auteur_id")
    fun join(table: string, on: string): Query {
        this.jointures = this.jointures + " JOIN " + table + " ON " + on
        return this
    }

    fun orderBy(colonne: string, sens: string): Query {
        this.ordre = " ORDER BY " + colonne + " " + sens
        return this
    }

    fun sql(): string {
        var s = "SELECT " + this.champs + " FROM " + this.table
        s = s + this.jointures
        if (this.conds != "") { s = s + " WHERE " + this.conds }
        s = s + this.ordre
        s = s + this.borne
        return s
    }

    fun get(): any {
        return DataImport.execSQL(this.db, this.sql(), this.params)
    }

    // Première ligne, ou null.
    fun first(): any {
        var lignes = this.get()
        for (r in lignes) { return r }
        return null
    }

    // Nombre total de lignes correspondant aux conditions (sans borne) —
    // utile pour calculer le nombre de pages.
    fun count(): int {
        var s = "SELECT COUNT(*) AS n FROM " + this.table
        if (this.conds != "") { s = s + " WHERE " + this.conds }
        var lignes = DataImport.execSQL(this.db, s, this.params)
        return lignes[0]["n"]
    }
}

// ---------------------------------------------------------------------
//  Migrator — migrations incrémentales (façon Alembic)
//  Suit les migrations appliquées dans une table `oktopios_migrations`
//  et n'exécute que celles qui manquent, dans l'ordre fourni.
// ---------------------------------------------------------------------
class Migrator {
    var db: string

    fun __construct(db: string) {
        this.db = db
        DataImport.execSQL(db, "CREATE TABLE IF NOT EXISTS oktopios_migrations (nom TEXT PRIMARY KEY, applique_le TEXT, descente TEXT)", [])
    }

    fun estApplique(nom: any): bool {
        var lignesSql = DataImport.execSQL(this.db, "SELECT nom FROM oktopios_migrations WHERE nom = ?", [nom])
        var n = 0
        for (r in lignesSql) { n = n + 1 }
        return n > 0
    }

    // Applique une migration (SQL `sql`) si pas déjà faite, en mémorisant le
    // SQL de descente `down` (peut être null) pour un futur rollback.
    fun appliquer(nom: any, sql: any, down: any): bool {
        if (this.estApplique(nom) == true) { return false }
        DataImport.execSQL(this.db, sql, [])
        DataImport.execSQL(this.db, "INSERT INTO oktopios_migrations (nom, applique_le, descente) VALUES (?, datetime('now'), ?)", [nom, down])
        return true
    }

    // Applique une liste ORDONNÉE de migrations { "nom", "sql", "down"? }.
    // Idempotent : relancer n'applique que les nouvelles. Renvoie le nombre
    // réellement appliquées.
    fun migrer(liste: any): int {
        var n = 0
        for (m in liste) {
            var down = null
            if (Map.has(m, "down") == true) { down = m["down"] }
            if (this.appliquer(m["nom"], m["sql"], down) == true) { n = n + 1 }
        }
        return n
    }

    // Annule une migration : exécute son SQL de descente (si présent) puis la
    // retire du suivi. Renvoie true si elle était appliquée.
    fun rollback(nom: any): bool {
        if (this.estApplique(nom) == false) { return false }
        var lignesSql = DataImport.execSQL(this.db, "SELECT descente FROM oktopios_migrations WHERE nom = ?", [nom])
        var down = null
        for (r in lignesSql) { down = r["descente"] }
        if (down != null) { DataImport.execSQL(this.db, down, []) }
        DataImport.execSQL(this.db, "DELETE FROM oktopios_migrations WHERE nom = ?", [nom])
        return true
    }

    // Annule la dernière migration appliquée ; renvoie son nom, ou null.
    fun rollbackLast(): any {
        var lignesSql = DataImport.execSQL(this.db, "SELECT nom FROM oktopios_migrations ORDER BY applique_le DESC, nom DESC LIMIT 1", [])
        var nom = null
        for (r in lignesSql) { nom = r["nom"] }
        if (nom == null) { return null }
        this.rollback(nom)
        return nom
    }

    // Noms des migrations déjà appliquées (ordre d'application).
    fun appliquees(): any {
        var lignesSql = DataImport.execSQL(this.db, "SELECT nom FROM oktopios_migrations ORDER BY applique_le, nom", [])
        var noms = []
        for (r in lignesSql) { noms = noms + [r["nom"]] }
        return noms
    }
}
